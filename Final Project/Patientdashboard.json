        "func": "let action = msg.req.params.type;\n\n\nif (action === \"feeling_unwell\") {\n    msg.payload = {\n        chatId: \"TELEGRAM CHAT ID\",\n        type: \"message\",\n        content: \"User selected: Feeling Unwell.\"\n    };\n    return msg;\n}\n\nif (action === \"need_help\") {\n    msg.payload = {\n        chatId: \"TELEGRAM CHAT ID\",\n        type: \"message\",\n        content: \"User selected: Need Help.\"\n    };\n    return msg;\n}\n\n\nreturn null;",
