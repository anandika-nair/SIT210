        "field": "payload",
        "fieldType": "msg",
        "format": "handlebars",
        "syntax": "mustache",
        "template": "<!DOCTYPE html>\n<html>\n<head>\n    <title>My Dashboard</title>\n    <style>\n        body {\n            font-family: Arial;\n            text-align: center;\n            background-color: #f5f5f5;\n            padding-top: 50px;\n        }\n\n        button {\n            width: 300px;\n            padding: 22px;\n            margin: 15px;\n            font-size: 22px;\n            border: none;\n            border-radius: 12px;\n            cursor: pointer;\n            display: block;\n            margin-left: auto;\n            margin-right: auto;\n        }\n\n        .unwell { background-color: orange; color: black; }\n        .help { background-color: gold; color: black; }\n    </style>\n</head>\n\n<body>\n    <h1>My Dashboard</h1>\n\n    <button class=\"unwell\" onclick=\"sendAction('feeling_unwell')\">Feeling Unwell</button>\n    <button class=\"help\" onclick=\"sendAction('need_help')\">Need Help</button>\n\n\n    <p id=\"status\"></p>\n\n    <script>\n        function sendAction(action) {\n            document.getElementById(\"status\").innerHTML = \"Button clicked: \" + action;\n\n            fetch(\"/action/\" + action, {\n                method: \"POST\"\n            })\n            .then(response => response.text())\n            .then(data => {\n                document.getElementById(\"status\").innerHTML = \"Sent: \" + action;\n            })\n            .catch(error => {\n                document.getElementById(\"status\").innerHTML = \"Error sending action\";\n            });\n        }\n    </script>\n</body>\n</html>",
