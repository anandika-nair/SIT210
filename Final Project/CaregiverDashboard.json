    {
        "id": "c8b402089e64a6b3",
        "type": "function",
        "z": "047db0f2b2fdc96d",
        "name": "Add Patient",
        "func": "let patientName = msg.payload.patientName;\n\nif (!patientName || patientName.trim() === \"\") {\n    msg.payload = \"Please enter the patient name.\";\n    return msg;\n}\n\nlet patients = flow.get(\"patients\") || [];\n\npatients.push({\n    name: patientName,\n    status: \"SAFE - Standby Patient\"\n});\n\nflow.set(\"patients\", patients);\n\nmsg.payload = \"Added: \" + patientName + \" - SAFE - Standby Patient\";\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 450,
