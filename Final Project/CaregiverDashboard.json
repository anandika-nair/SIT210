    {
        "id": "fa56dfabf2fb8ca4",
        "type": "function",
        "z": "047db0f2b2fdc96d",
        "name": "Format Patient Status",
        "func": "if (msg.payload === \"FALL_DETECTED\") {\n    msg.payload = \"ALERT: FALL DETECTED - Patient 1 needs immediate help\";\n} else if (msg.payload === \"SAFE\") {\n    msg.payload = \"SAFE - Patient 1 is okay\";\n} else {\n    msg.payload = \"Waiting for patient data\";\n}\n\nreturn msg;",
